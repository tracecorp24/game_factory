# CreativeForge Intelligence Studio v3.0 Environment Configuration

# Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=creativeforge

# SQLAlchemy Database URLs
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/creativeforge
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/creativeforge

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO / Local)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=creativeforge-artifacts
S3_REGION=us-east-1

# Security & Redaction
SECRET_KEY=change-this-in-production-super-secret-key-32-bytes-min
ENCRYPTION_KEY=
PII_REDACTION_ENABLED=True

# Temporal Orchestration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Model Gateway & LiteLLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LITELLM_MASTER_KEY=
