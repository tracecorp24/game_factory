{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    }
  },
  "2": {
    "class_type": "IPAdapterModelLoader",
    "inputs": {
      "ipadapter_file": "ip-adapter_sdxl_plus.safetensors"
    }
  },
  "3": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_vit_h.safetensors"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "${reference_dna_image}"
    }
  },
  "5": {
    "class_type": "IPAdapterApply",
    "inputs": {
      "model": ["1", 0],
      "ipadapter": ["2", 0],
      "clip_vision": ["3", 0],
      "image": ["4", 0],
      "weight": "${ipadapter_weight}"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "game DNA cohesive visual assets, consistent art style, unified brand palette, high fidelity game art, ${prompt}, ${style_tokens}"
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "style mismatch, brand inconsistency, clashing colors, bad anatomy, artifacts, ${negative_prompt}"
    }
  },
  "8": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "${width}",
      "height": "${height}",
      "batch_size": 1
    }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["5", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["8", 0],
      "seed": "${seed}",
      "steps": "${steps}",
      "cfg": "${cfg}",
      "sampler_name": "dpmpp_2m_sde",
      "scheduler": "karras",
      "denoise": 1.0
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["9", 0],
      "vae": ["1", 2]
    }
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "CreativeForge_IPAdapter_GameDNA",
      "images": ["10", 0]
    }
  }
}
